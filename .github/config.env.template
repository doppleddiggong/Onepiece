# 환경 변수 설정 템플릿
# 이 파일을 config.env로 복사하고 실제 값을 입력하세요

# ====================================
# Jira 설정
# ====================================

# Jira 사이트 도메인 (예: jeonminwoo0625-1762930390335)
# Atlassian 관리 페이지에서 확인 가능
JIRA_SITE=

# 프로젝트 키 (예: UN, PROJ)
# Jira 프로젝트 설정에서 확인
JIRA_PROJECT=

# Jira 계정 이메일
JIRA_EMAIL=

# Jira API 토큰
# 생성: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=

# ====================================
# OpenAI 설정
# ====================================

# OpenAI API 키
# 생성: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Assistant ID (선택사항)
# 특정 Assistant를 사용하는 경우에만 설정
OPENAI_ASSISTANT_ID=

# ====================================
# 사용 방법
# ====================================
#
# 1. 이 파일을 복사:
#    cp .github/config.env.template .github/config.env
#
# 2. config.env 파일 편집하여 실제 값 입력
#
# 3. .gitignore 확인:
#    config.env는 Git에 커밋되지 않아야 함
#
# 4. 테스트:
#    cd .github/scripts/devlog_klingo
#    python devlog_generate.py --date 2025-11-21
#
